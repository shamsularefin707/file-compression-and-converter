# ==========================================
# FILEFORGE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Monetization Flags (Disabled by default)
VITE_ADS_ENABLED=false
VITE_AD_PROVIDER=none # 'none' | 'adsense' | 'ezoic'
VITE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
VITE_EZOIC_PUBLISHER_ID=000000

# 2. Subscription & Feature Gating
VITE_PRO_GATING_ENABLED=false

# 3. Privacy-Conscious Telemetry
VITE_GA_ID=G-XXXXXXXXXX

# 4. Backend Processing Serverless Endpoint
VITE_API_BASE_URL=/api
